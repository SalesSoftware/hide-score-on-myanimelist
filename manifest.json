{
  "manifest_version": 3,
  "name": "Hide score on myanimelist",
  "version": "1.0.0",
  "description": "Hides scores on myanimelist",
  "permissions":[
    "storage"
  ],
  "icons": {
    
  },
  "action": {
    "default_icon":{

    }, 
    "default_title": "Gotta block them all",
    "default_popup": "popup-menu.html"    
  },
  "content_scripts": [
        {
            "matches": ["https://myanimelist.net/anime*", "https://myanimelist.net/manga*"],
            "css": ["css/preload-hide.css"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://myanimelist.net/anime*", "https://myanimelist.net/manga*"],
            //ATTENTION!: storageSync.class.js has to be in the first position
            "js": ["js/storageSync.class.js", "js/scorehider.class.js"],
            "run_at": "document_end"
        }
    ],
  "browser_specific_settings": {
    "gecko": {
        //apperantely this is required in firefox
        //TODO: look into it later
        "id": "malhider@extension"
    }
  } 
}